<?xml version="1.0" encoding="utf-8"?>
<!-- The toolbar while items are selected in the list: choosing as buttons, every action
     in the overflow. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <item
        android:id="@+id/select_all"
        android:icon="@drawable/baseline_select_all_white_24"
        android:title="@string/select_all"
        app:showAsAction="always" />
    <item
        android:id="@+id/invert_selection"
        android:icon="@drawable/baseline_flip_white_24"
        android:title="@string/invert_selection"
        app:showAsAction="always" />

    <!-- always there, like ✕ and Back; first, so it never moves (and on a tablet in the
         place of the library menu's Select items) -->
    <item
        android:id="@+id/end_selection"
        android:title="@string/end_selection"
        app:showAsAction="never" />

    <!-- the files on this device: in groups too, so before the My Library-only edits,
         and where the library menu has it -->
    <group android:id="@+id/selection_files">
        <item
            android:id="@+id/selection_attachments"
            android:title="@string/manage_attachments"
            app:showAsAction="never" />
    </group>

    <!-- My Library only: edits in groups aren't uploaded -->
    <group android:id="@+id/selection_edits">
        <item
            android:id="@+id/selection_tags"
            android:title="@string/add_and_remove_tags"
            app:showAsAction="never" />
        <item
            android:id="@+id/selection_add_to_collection"
            android:title="@string/add_to_collection"
            app:showAsAction="never" />
        <!-- only while a collection is open; last, so hiding it moves nothing -->
        <item
            android:id="@+id/selection_remove_from_collection"
            android:title="@string/remove_from_collection"
            app:showAsAction="never" />
    </group>
</menu>
