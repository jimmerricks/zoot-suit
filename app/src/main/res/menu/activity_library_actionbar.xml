<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- while a sync runs: its progress; tapping it shows the details -->
    <item
        android:id="@+id/sync_status"
        android:title="@string/syncing"
        android:visible="false"
        app:showAsAction="always|withText" />

    <item
        android:id="@+id/pending_edits"
        android:title="@string/sync"
        android:visible="false"
        app:showAsAction="always|withText" />

    <item
        android:id="@+id/search"
        android:icon="@drawable/baseline_search_white_24"
        android:title="@string/search_title"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/library_filter"
        android:icon="@drawable/baseline_filter_list_white_24"
        android:title="@string/filter"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/filter_menu"
        android:icon="@drawable/ic_sort_white_24"
        android:title="@string/sort"
        app:showAsAction="ifRoom" />


    <!-- while bulk downloads are at work -->
    <item
        android:id="@+id/stop_downloads"
        android:title="@string/stop_downloads"
        android:visible="false"
        app:showAsAction="never" />

    <!-- while a search or filter narrows the list -->
    <item
        android:id="@+id/clear_search_and_filters"
        android:title="@string/clear_search_and_filters"
        android:visible="false"
        app:showAsAction="never" />

    <!-- the same as a long press on an item, with nothing chosen yet -->
    <item
        android:id="@+id/start_selection"
        android:title="@string/start_selection"
        android:visible="false"
        app:showAsAction="never" />

    <item
        android:id="@+id/settings"
        android:icon="@drawable/baseline_settings_applications_white_24"
        android:title="@string/settings"
        app:showAsAction="collapseActionView" />

    <item
        android:id="@+id/force_resync"
        android:visible="false"
        android:title="@string/force_resync"
        app:showAsAction="collapseActionView"/>

</menu>