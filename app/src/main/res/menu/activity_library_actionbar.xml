<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- the sync button, always first, its look and words set in onPrepareOptionsMenu
         (an action view): still, with a dot while edits wait; tap syncs. Turning while a
         sync or bulk downloads run; tap shows them. A long press shows the sync dialog -->
    <item
        android:id="@+id/sync"
        android:title="@string/sync"
        app:showAsAction="always" />

    <item
        android:id="@+id/search"
        android:icon="@drawable/baseline_search_white_24"
        android:title="@string/search_title"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/library_filter"
        android:icon="@drawable/baseline_filter_list_white_24"
        android:title="@string/filter"
        app:showAsAction="ifRoom" />

    <item
        android:id="@+id/filter_menu"
        android:icon="@drawable/ic_sort_white_24"
        android:title="@string/sort"
        app:showAsAction="ifRoom" />


    <!-- the same as a long press on an item, with nothing chosen yet; first of the menu's
         own entries (filter and sort, above, are toolbar buttons from 600dp wide) -->
    <item
        android:id="@+id/start_selection"
        android:title="@string/start_selection"
        android:visible="false"
        app:showAsAction="never" />

    <!-- the files of every item the list shows; Select items, above, for some of them -->
    <item
        android:id="@+id/manage_attachments"
        android:title="@string/manage_attachments"
        android:visible="false"
        app:showAsAction="never" />

    <item
        android:id="@+id/force_resync"
        android:visible="false"
        android:title="@string/force_resync"
        app:showAsAction="collapseActionView"/>

</menu>