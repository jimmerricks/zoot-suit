<?xml version="1.0" encoding="utf-8"?>
<!-- A tag in the item dialog: tapping it opens the tag's items; the cross removes it from
     the item (hidden where tags can't be edited, in groups). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout_notes_entry"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:orientation="horizontal"
    tools:context=".LibraryActivity.ItemView.ItemTagEntry">

    <ImageView
        android:id="@+id/imageView_tag_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/baseline_label_24" />

    <TextView
        android:id="@+id/textView_tag"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.AppCompat.Subhead" />

    <ImageButton
        android:id="@+id/imageButton_remove_tag"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@drawable/baseline_close_24"
        android:visibility="gone" />
</LinearLayout>
