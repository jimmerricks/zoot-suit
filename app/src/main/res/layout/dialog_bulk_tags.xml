<?xml version="1.0" encoding="utf-8"?>
<!-- "Add and remove tags" (BulkTagsDialog), built like Manage attachments: what it applies
     to, how it works, a field that finds a tag or adds a new one, the tags as rows with a
     three-state box, then Apply as a full-width button naming the changes. The field and
     the button stay put; the rows scroll between them (the list's weight lets it shrink
     when the dialog is short, as with the keyboard up). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/DialogBody">

    <TextView
        android:id="@+id/textView_bulk_tags_scope"
        style="@style/DialogLead" />

    <TextView
        android:id="@+id/textView_bulk_tags_hint"
        style="@style/DialogHint" />

    <EditText
        android:id="@+id/editText_bulk_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Find or add a tag"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLength="255" />

    <TextView
        android:id="@+id/textView_bulk_tags_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_bulk_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:scrollbars="vertical" />

    <com.mickstarify.zooforzotero.common.DialogActions style="@style/DialogActions">
        <!-- text and enabled state set in code -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_apply_tags"
            style="@style/DialogAction"
            android:text="Apply" />
    </com.mickstarify.zooforzotero.common.DialogActions>
</LinearLayout>
