<?xml version="1.0" encoding="utf-8"?>
<!-- An attachment in the item dialog: icon, file name, and below it the state on this
     device when there is one (downloaded, edited here, ...). -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constraintLayout_attachments_entry"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="36dp"
    tools:context=".LibraryActivity.ItemView.ItemAttachmentEntry">

    <ImageView
        android:id="@+id/imageView_attachment_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/treeitem_attachment_link_2x"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView_filename"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:text="@string/hello_blank_fragment"
        android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
        app:layout_constraintBottom_toTopOf="@+id/textView_attachment_state"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imageView_attachment_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/textView_attachment_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/textView_filename"
        app:layout_constraintStart_toStartOf="@+id/textView_filename"
        app:layout_constraintTop_toBottomOf="@+id/textView_filename"
        app:layout_goneMarginBottom="6dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
