<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="20dp">

    <TextView
        android:id="@+id/textView_filter_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium" />

    <TextView
        style="@style/DialogSectionHeader"
        android:text="Item has" />

    <CheckBox
        style="@style/DialogChoice"
        android:id="@+id/checkBox_filter_has_pdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PDF attachment" />

    <CheckBox
        style="@style/DialogChoice"
        android:id="@+id/checkBox_filter_has_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notes" />

    <TextView
        style="@style/DialogSectionHeader"
        android:text="On this device" />

    <CheckBox
        style="@style/DialogChoice"
        android:id="@+id/checkBox_filter_on_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PDF downloaded" />

    <CheckBox
        style="@style/DialogChoice"
        android:id="@+id/checkBox_filter_edited"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edits waiting to sync" />

    <TextView
        style="@style/DialogSectionHeader"
        android:text="Tags" />

    <EditText
        android:id="@+id/editText_tag_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search tags"
        android:imeOptions="actionDone"
        android:inputType="text" />

    <TextView
        android:id="@+id/textView_no_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="No matching tags"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listView_tags"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:choiceMode="multipleChoice"
        android:divider="@null"
        android:dividerHeight="0dp" />

</LinearLayout>
