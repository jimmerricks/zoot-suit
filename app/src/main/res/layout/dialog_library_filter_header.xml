<?xml version="1.0" encoding="utf-8"?>
<!-- The filter's first row (LibraryFilterDialog): its conditions, then the tag search;
     the tags follow as rows of the same list, so they all scroll together. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <TextView
        style="@style/DialogHint"
        android:paddingBottom="0dp"
        android:text="Shows only the items that match every ticked box." />

    <TextView
        style="@style/DialogSectionHeader"
        android:text="Item has" />

    <CheckBox
        style="@style/DialogChoice"
        android:id="@+id/checkBox_filter_has_pdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PDF attachment" />

    <CheckBox
        style="@style/DialogChoice"
        android:id="@+id/checkBox_filter_has_html"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HTML snapshot" />

    <!-- EPUB, images, Word files...: not a PDF, an HTML snapshot or a web link -->
    <CheckBox
        style="@style/DialogChoice"
        android:id="@+id/checkBox_filter_has_other"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Other attachment" />

    <CheckBox
        style="@style/DialogChoice"
        android:id="@+id/checkBox_filter_has_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notes" />

    <TextView
        style="@style/DialogSectionHeader"
        android:text="On this device" />

    <CheckBox
        style="@style/DialogChoice"
        android:id="@+id/checkBox_filter_on_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PDF downloaded" />

    <CheckBox
        style="@style/DialogChoice"
        android:id="@+id/checkBox_filter_html_on_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HTML snapshot downloaded" />

    <CheckBox
        style="@style/DialogChoice"
        android:id="@+id/checkBox_filter_edited"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Edits waiting to sync" />

    <!-- the top of the list while the tag search is in use -->
    <TextView
        android:id="@+id/textView_tags_header"
        style="@style/DialogSectionHeader"
        android:text="Tags" />

    <EditText
        android:id="@+id/editText_tag_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search tags"
        android:imeOptions="actionDone"
        android:inputType="text" />

    <TextView
        android:id="@+id/textView_no_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="No matching tags"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="?android:attr/textColorSecondary"
        android:visibility="gone" />

</LinearLayout>
