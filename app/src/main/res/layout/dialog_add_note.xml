<?xml version="1.0" encoding="utf-8"?>
<!-- Adding or editing a note (EditNoteDialog), built like Manage attachments: the note's
     text, then Save note as a full-width button. The button stays put; the field grows up
     to 16 lines and then scrolls. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/DialogBody">

    <EditText
        android:id="@+id/edit_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="top|start"
        android:hint="Note"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="16"
        android:minLines="3" />

    <com.mickstarify.zooforzotero.common.DialogActions
        android:id="@+id/dialog_actions"
        style="@style/DialogActions">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSubmit"
            style="@style/DialogAction"
            android:text="Save note" />
    </com.mickstarify.zooforzotero.common.DialogActions>
</LinearLayout>
