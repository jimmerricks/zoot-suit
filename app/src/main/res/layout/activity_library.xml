<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/drawerlayout_library"
        tools:context=".LibraryActivity.LibraryActivity">
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                style="@style/Widget.ZooForZotero.Toolbar" />

        </com.google.android.material.appbar.AppBarLayout>

        <include layout="@layout/content_library" android:layout_width="match_parent"
                 android:layout_height="match_parent"/>

    </LinearLayout>

    <!-- the sidebar: libraries, the collection tree, Unfiled / My Publications / Trash
         (SidebarAdapter). A RecyclerView because a NavigationView menu can't nest.
         Insets are applied in code: the status bar strip above it takes the
         toolbar's dark colour, so the white status icons stay visible. -->
    <FrameLayout
            android:id="@+id/sidebar_container"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?android:attr/colorBackground">

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sidebar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:scrollbars="vertical"/>

        <View
                android:id="@+id/sidebar_status_bar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="top"
                android:background="@color/colorPrimaryDark"/>
    </FrameLayout>
</androidx.drawerlayout.widget.DrawerLayout>