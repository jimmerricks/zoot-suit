<?xml version="1.0" encoding="utf-8"?>
<!-- Laid out like the Settings list that opens it: headers, rows and insets as there
     (SettingsForm styles), no card. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LibraryActivity.WebDAV.WebDAVSetup"
    tools:showIn="@layout/activity_web_dav_setup">

    <!-- focusable itself: the address field doesn't take the focus, and the keyboard
         doesn't cover the screen, until it's tapped -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <TextView
            style="@style/SettingsForm.Header"
            android:text="Server" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayout_webdav_host"
            style="@style/SettingsForm.Field"
            android:hint="@string/host_url"
            app:helperText="https:// and /zotero are added if missing (see Advanced).">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayout_webdav_user"
            style="@style/SettingsForm.Field"
            android:hint="@string/username"
            app:helperText="Optional.">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textWebEditText" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayout_webdav_password"
            style="@style/SettingsForm.Field"
            android:hint="@string/password"
            app:endIconMode="password_toggle"
            app:helperText="Optional.">

            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- opens and closes the section below -->
        <LinearLayout
            android:id="@+id/button_webdav_advanced_config"
            style="@style/SettingsForm.Row"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/SettingsForm.Title"
                    android:text="@string/advanced_configuration" />

                <TextView
                    style="@style/SettingsForm.Summary"
                    android:text="Address format, certificate check, authentication, timeouts" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imageView_webdav_advanced_chevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="16dp"
                android:importantForAccessibility="no"
                android:rotation="90"
                android:src="@drawable/baseline_chevron_right_24" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayout_advanced_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/row_add_zotero_host"
                style="@style/SettingsForm.Row">

                <TextView
                    style="@style/SettingsForm.Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Add https:// and /zotero to the address" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/checkBox_add_zotero_host"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:checked="true"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_verify_ssl"
                style="@style/SettingsForm.Row">

                <TextView
                    style="@style/SettingsForm.Title"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Verify the server's certificate" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/checkBox_Verify_ssl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:checked="true"
                    android:clickable="false"
                    android:focusable="false" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/TextInputLayout_webdav_auth_mode"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="?android:attr/listPreferredItemPaddingStart"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="?android:attr/listPreferredItemPaddingEnd"
                android:layout_marginBottom="8dp"
                android:hint="Authentication"
                app:helperText="Change this only if signing in fails.">

                <AutoCompleteTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:text="AUTOMATIC" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout_webdav_connect_timeout"
                style="@style/SettingsForm.Field"
                android:hint="Connect timeout (ms)"
                app:helperText="How long connecting may take. 0 waits forever. Default 10000.">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout_webdav_read_timeout"
                style="@style/SettingsForm.Field"
                android:hint="Read timeout (ms)"
                app:helperText="How long the server may take to answer. 0 waits forever. Default 30000.">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout_webdav_write_timeout"
                style="@style/SettingsForm.Field"
                android:hint="Write timeout (ms)"
                app:helperText="How long sending a file may stall. 0 waits forever. Default 30000.">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <Button
            android:id="@+id/button_webdav_connect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginStart="?android:attr/listPreferredItemPaddingStart"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="?android:attr/listPreferredItemPaddingEnd"
            android:text="@string/save_connect" />
    </LinearLayout>
</ScrollView>
