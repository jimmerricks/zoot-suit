<?xml version="1.0" encoding="utf-8"?>
<!-- Same layout as dialog_library_filter: section headers, then one choice per row.
     The field checkboxes are added by LibrarySearchDialog, one per LibrarySearch.Field. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/editText_search_query"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Words, or a &quot;quoted phrase&quot;"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Searches the whole library. Every word must match; case and accents are ignored."
            android:textAppearance="@style/TextAppearance.AppCompat.Caption" />

        <TextView
            style="@style/DialogSectionHeader"
            android:text="Search in" />

        <LinearLayout
            android:id="@+id/layout_search_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
