<?xml version="1.0" encoding="utf-8"?>
<!-- The add-tag dialog: the library's coloured tags as one-tap buttons (QuickTags; gone when
     there are none), then one field that suggests the library's tags as you type. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp">

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroup_coloured_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:chipSpacingVertical="0dp" />

    <AutoCompleteTextView
        android:id="@+id/editText_new_tag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:completionThreshold="1"
        android:hint="Tag"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLength="255" />
</LinearLayout>
