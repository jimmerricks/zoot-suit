<?xml version="1.0" encoding="utf-8"?>
<!-- The add-tag dialog, built like Manage attachments: a grey line on how it works, the
     library's coloured tags as one-tap buttons (QuickTags; gone when there are none), one
     field that suggests the library's tags as you type, then Add tag as a full-width button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/DialogBody">

    <!-- text set in code: it mentions the coloured tags only when there are some -->
    <TextView
        android:id="@+id/textView_add_tag_hint"
        style="@style/DialogHint" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroup_coloured_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:chipSpacingVertical="0dp" />

    <AutoCompleteTextView
        android:id="@+id/editText_new_tag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:completionThreshold="1"
        android:hint="Tag"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLength="255" />

    <com.mickstarify.zooforzotero.common.DialogActions style="@style/DialogActions">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_add_tag"
            style="@style/DialogAction"
            android:text="Add tag" />
    </com.mickstarify.zooforzotero.common.DialogActions>
</LinearLayout>
