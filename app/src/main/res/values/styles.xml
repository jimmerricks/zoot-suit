<resources>

    <!-- Section headers inside the filter and sort dialogs, matching the settings categories. -->
    <style name="DialogSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Small</item>
        <item name="android:textColor">?attr/colorAccent</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- A checkbox or radio option in the filter and sort dialogs: one line of text, so
         36dp high instead of the theme's 48dp touch-target minimum. -->
    <style name="DialogChoice">
        <item name="android:minHeight">36dp</item>
    </style>
    <!-- The parts of a dialog, as Manage attachments has them. Body: the custom view's
         insets, as the title's. Lead: what the dialog acts on ("Applies to 2 items: those
         selected"). Hint: how it works, grey. Actions: full-width buttons in the body that
         name what they do (with counts where it helps); the filled one is the main act, the
         outlined one the other, together in a DialogActions with the button that leaves
         (Cancel or Close, in place of AlertDialog's button bar): all on one line when the
         labels fit, else the acting ones side by side or stacked and the leaving one under
         them. -->
    <style name="DialogBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="DialogLead">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Subhead</item>
    </style>

    <style name="DialogHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.AppCompat.Body1</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="DialogActions">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- a text field in a dialog's body (WebDAV server) -->
    <style name="DialogField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="DialogAction" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="DialogAction.Other" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>
