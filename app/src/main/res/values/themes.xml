<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZooForZotero" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/themePrimary</item>
        <item name="colorOnPrimary">@color/themeOnPrimary</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">@color/themePrimary</item>
    </style>


    <style name="Theme.ZooForZotero.NoActionBar" parent="Theme.ZooForZotero">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Every toolbar: white title, subtitle, navigation/overflow icons and search field on
         the brand purple, in dark mode too (where the theme's colorPrimary is a light tint);
         the overflow menu itself stays light. -->
    <style name="Widget.ZooForZotero.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:theme">@style/ThemeOverlay.ZooForZotero.Toolbar</item>
        <item name="android:background">@color/colorPrimary</item>
        <item name="popupTheme">@style/ThemeOverlay.MaterialComponents.Light</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="subtitleTextColor">@android:color/white</item>
    </style>

    <style name="ThemeOverlay.ZooForZotero.Toolbar" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar">
        <item name="colorControlNormal">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
        <item name="android:textColorHint">#B3FFFFFF</item>
        <item name="actionMenuTextColor">@android:color/white</item>
    </style>
</resources>