<?xml version="1.0" encoding="utf-8"?>
<!-- Round launcher icon before API 26 (adaptive icons are in mipmap-anydpi-v26). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/icon_background" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:drawable="@drawable/icon_glyph"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp" />
</layer-list>
